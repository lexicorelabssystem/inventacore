# Backend environment (production-ready template)
# Copy to `.env` locally and replace placeholder values.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# PostgreSQL (Render or any hosted Postgres)
# Important:
# - Do NOT use <> in final values.
# - URL-encode password if it contains special chars (@, #, %, :, /, ?).
# - This repo uses DIRECT_DATABASE_URL first when it is present.
# - If you do not split runtime and migration URLs, you can use the same value in both variables.
# - PRISMA_MIGRATE_DATABASE_URL is optional and only used by `npx prisma migrate deploy`.
DATABASE_URL=postgresql://USER:REPLACE_WITH_URLENCODED_PASSWORD@REPLACE_WITH_HOST:5432/DB?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:REPLACE_WITH_URLENCODED_PASSWORD@REPLACE_WITH_HOST:5432/DB?sslmode=require
PRISMA_MIGRATE_DATABASE_URL=
# Optional helpers for cutover scripts.
BACKUP_DATABASE_URL=
RESTORE_DATABASE_URL=
CHECK_DATABASE_URL=

# Preflight de aislamiento; se usan solo al ejecutar `npm run db:preflight:new`.
NEW_DATABASE_URL=
EXISTING_DATABASE_URL=
NEW_DATABASE_LABEL=
# Debe ser NUEVA:<valor de NEW_DATABASE_LABEL>
NEW_DATABASE_CONFIRM=
ALLOW_SAME_DATABASE_HOST=false

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
CORS_ORIGIN=https://REPLACE_WITH_FRONTEND_DOMAIN.vercel.app

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.yourdomain.com

UTM_VALUE_CLP=65000

# Optional mail settings
SUPPORT_NOTIFY_EMAIL=
ACCOUNTING_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=15000

# Test suite (scripts/criticalSuite.js)
# Credenciales de un ADMIN_CENTRAL existente para ejecutar `npm test`
TEST_CENTRAL_EMAIL=
TEST_CENTRAL_PASSWORD=
# Optional: si la API ya esta corriendo en otra URL, por ejemplo http://127.0.0.1:3000
API_BASE_URL=

# Seed inicial (obligatorio solo al ejecutar `npm run db:seed`)
SEED_ADMIN_CENTRAL_EMAIL=
SEED_ADMIN_CENTRAL_PASSWORD=
SEED_ADMIN_ESTABLISHMENT_EMAIL=
SEED_ADMIN_ESTABLISHMENT_PASSWORD=

# Creacion puntual de usuario de establecimiento
CREATE_SCHOOL_USER_NAME=
CREATE_SCHOOL_USER_EMAIL=
CREATE_SCHOOL_USER_PASSWORD=
CREATE_SCHOOL_USER_INSTITUTION_ID=
CREATE_SCHOOL_USER_ESTABLISHMENT_ID=

# Mantenimiento explicito de hash de administrador
REHASH_ADMIN_EMAIL=
REHASH_ADMIN_PASSWORD=
