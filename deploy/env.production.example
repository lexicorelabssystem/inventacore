# Copiar exclusivamente en el servidor como .env.production y asignar chmod 600.
# No versionar el archivo real.

APP_IMAGE_TAG=local

POSTGRES_DB=inventacore_labsystem
POSTGRES_USER=REPLACE_WITH_EXCLUSIVE_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD

RESTORE_POSTGRES_DB=inventacore_labsystem_restore
RESTORE_POSTGRES_USER=REPLACE_WITH_EXCLUSIVE_RESTORE_USER
RESTORE_POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_RESTORE_PASSWORD

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
CORS_ORIGIN=https://inventacore.labsystem.cl
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
UTM_VALUE_CLP=65000

SUPPORT_NOTIFY_EMAIL=
ACCOUNTING_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000

# Solo para el preflight autorizado; no se usan durante el arranque normal.
NEW_DATABASE_URL=
EXISTING_DATABASE_URL=
NEW_DATABASE_LABEL=inventacore-labsystem
NEW_DATABASE_CONFIRM=NUEVA:inventacore-labsystem
ALLOW_SAME_DATABASE_HOST=false
