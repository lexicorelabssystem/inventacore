# Frontend environment (Vercel / local)
# Copy to `frontend/.env.local` for local dev.

# In Vercel production, prefer `/api` and let `vercel.json` proxy to the backend.
# Use an absolute URL only for direct local/integration testing if needed.
VITE_API_BASE=/api
DEV_API_PROXY_TARGET=http://localhost:3000
VITE_PUBLIC_SHEET_BASE=https://REPLACE_WITH_PUBLIC_FRONTEND_DOMAIN
