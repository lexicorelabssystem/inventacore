{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.inventario.lexicorelabssystem.cl/api/:path*"
    },
    {
      "source": "/assets/public/:path*",
      "destination": "https://api.inventario.lexicorelabssystem.cl/assets/public/:path*"
    },
    {
      "source": "/((?!api|assets/|icons/|manual/|vite.svg|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
