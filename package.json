{
  "name": "inventario",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "homepage": "https://inventacore.ale.lexicorelabssystem.cl/",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "deploy:prepare": "npm run build:frontend && npm run prisma:generate",
    "deploy:check": "npm run deploy:prepare && npm test",
    "deploy:where": "node -e \"console.log('Frontend listo en: frontend/dist')\"",
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "test": "node scripts/criticalSuite.js",
    "test:api": "node scripts/testApiSimple.js",
    "test:critical": "node scripts/criticalSuite.js",
    "db:check": "node scripts/checkDb.js",
    "db:preflight:new": "node scripts/verifyNewDatabaseTarget.js",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "release:check": "npm run prisma:deploy && npm run prisma:generate && npm test",
    "release:full": "npm run db:backup && npm run release:check && npm run test:smoke-admin",
    "hooks:install": "git config core.hooksPath githooks",
    "dev:db": "prisma dev",
    "dev:api": "node src/server.js",
    "dev:full": "concurrently -n API,WEB \"npm run dev:api\" \"npm --prefix frontend run dev\"",
    "dev": "npm run dev:full",
    "admin:setup": "node --preserve-symlinks --preserve-symlinks-main scripts/setupAdminLocal.js",
    "admin:doctor": "node --preserve-symlinks --preserve-symlinks-main scripts/withEnvFile.js .env.admin.local node --preserve-symlinks --preserve-symlinks-main scripts/adminDoctor.js",
    "admin:prisma:deploy": "node --preserve-symlinks --preserve-symlinks-main scripts/withEnvFile.js .env.admin.local npx prisma migrate deploy",
    "admin:prisma:generate": "node --preserve-symlinks --preserve-symlinks-main scripts/withEnvFile.js .env.admin.local npx prisma generate",
    "admin:db:seed": "node --preserve-symlinks --preserve-symlinks-main scripts/withEnvFile.js .env.admin.local node --preserve-symlinks --preserve-symlinks-main prisma/seed.js",
    "admin:db:check": "node --preserve-symlinks --preserve-symlinks-main scripts/withEnvFile.js .env.admin.local node --preserve-symlinks --preserve-symlinks-main scripts/checkDb.js",
    "admin:dev": "npm run admin:doctor && concurrently -n API,WEB \"node --preserve-symlinks --preserve-symlinks-main scripts/withEnvFile.js .env.admin.local node --preserve-symlinks --preserve-symlinks-main src/server.js\" \"npm --prefix frontend run dev -- --mode admin\"",
    "test:guards": "node scripts/testInstitutionIdGuard.js",
    "test:integration": "node scripts/integrationTests.js",
    "test:transfer-deleted": "node scripts/testTransferDeletedAsset.js",
    "test:smoke-admin": "node scripts/smokeAdminCrud.js",
    "test:smoke-points": "node scripts/smokeRecentPoints.js",
    "test:asset-conflict": "node scripts/testAssetCreateConflict.js",
    "db:backup": "node scripts/dbBackup.js",
    "db:snapshot": "node scripts/exportSnapshot.js",
    "db:restore": "node scripts/dbRestore.js",
    "db:restore-latest": "node scripts/dbRestoreLatest.js",
    "db:seed": "node prisma/seed.js",
    "db:reset-single-admin": "node scripts/resetSingleAdmin.js",
    "cleanup:test": "node scripts/cleanupTest.js",
    "purge:inactive": "node scripts/purgeInactiveAdminTree.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.9.1",
    "zod": "^4.3.6"
  }
}
